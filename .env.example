# === StudyPal Environment Variables ===

# Groq API Key (required for chat & summarization)
GROQ_API_KEY=your_groq_api_key

# LLM Model (optional, default: llama3-8b-8192)
# Options: llama3-8b-8192, llama3-70b-8192, mixtral-8x7b-32768
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Embedding Model (optional, default: all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Chunk settings (optional)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ChromaDB persist directory (optional)
CHROMA_PERSIST_DIR=data/chroma_db
